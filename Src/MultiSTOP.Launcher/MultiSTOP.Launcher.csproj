<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>MultiSTOP</AssemblyName>
    <RootNamespace>MultiSTOP.Launcher</RootNamespace>
    <Title>MultiSTOP</Title>
    <AssemblyTitle>MultiSTOP</AssemblyTitle>
    <FileDescription>MultiSTOP - F-STOP Community Launcher</FileDescription>
    <Product>MultiSTOP</Product>
    <Company>Hammerhead Studios</Company>
    <Description>Community launcher for a local F-STOP installation.</Description>
    <Copyright>Copyright © 2026 Hammerhead Studios. All rights reserved.</Copyright>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0 BETA</InformationalVersion>
    <NeutralLanguage>en-US</NeutralLanguage>

    <ApplicationIcon>Assets\MultiSTOP.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>
