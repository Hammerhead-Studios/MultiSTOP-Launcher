<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MultiSTOP.Launcher.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#FFFFB13D" />
        <ColorPaletteResources x:Key="Light" Accent="#FFE98A2E" />
      </FluentTheme.Palettes>
    </FluentTheme>
  </Application.Styles>
</Application>
